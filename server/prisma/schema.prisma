generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  RECORDS_OFFICER
  DOCTOR_IN_CHARGE
}

enum StaffStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  ROUTINE_CHECKUP
  EMERGENCY_REVIEW
}

enum EncounterStatus {
  DRAFT
  REVIEWED
  VOIDED
}

// A hospital stay. A patient has at most one ADMITTED admission at a time (SQL partial unique
// index plus a no-overlap exclusion constraint); a discharged admission is permanent history.
enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum NotificationType {
  DIRECT
  BROADCAST
}

enum AuditAction {
  ADMIN_BOOTSTRAPPED
  STAFF_CREATED
  STAFF_ROLE_CHANGED
  STAFF_STATUS_CHANGED
  PATIENT_CREATED
  PATIENT_VIEWED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  PATIENT_REACTIVATED
  MEDICAL_RECORD_CREATED
  MEDICAL_RECORD_VIEWED
  MEDICAL_RECORD_UPDATED
  MEDICAL_RECORD_FINALIZED
  MEDICAL_RECORD_AMENDED
  MEDICAL_HISTORY_VIEWED
  CLINICAL_REPORT_VIEWED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_VIEWED
  APPOINTMENT_STATUS_CHANGED
  APPOINTMENT_CANCELLED
  NOTIFICATION_SENT
  NOTIFICATION_BROADCAST_CREATED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  PATIENT_ADMITTED
  PATIENT_READMITTED
  ADMISSION_VIEWED
  ADMISSION_ROOM_CHANGED
  PATIENT_DISCHARGED
  MEDICATION_CREATED
  MEDICATION_DEACTIVATED
  MEDICATION_REACTIVATED
  STAFF_SESSION_REVOKED
}

enum AuditEntityType {
  AUTH_ATTEMPT
  STAFF_USER
  PATIENT
  APPOINTMENT
  ENCOUNTER
  NOTIFICATION
  ADMISSION
  MEDICATION
}

model StaffUser {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffNumber        String      @unique @default(dbgenerated("('STF-'::text || upper(replace((gen_random_uuid())::text, '-'::text, ''::text)))")) @db.VarChar(36)
  firstName          String      @db.VarChar(100)
  lastName           String      @db.VarChar(100)
  email              String      @unique @db.VarChar(254)
  role               StaffRole
  status             StaffStatus @default(PENDING)
  passwordHash       String?     @db.VarChar(512)
  passwordChangedAt  DateTime?   @db.Timestamptz(3)
  /// True while the current password was issued by an administrator (creation or reset);
  /// cleared only when the staff member sets their own password.
  mustChangePassword Boolean     @default(false)
  lastLoginAt        DateTime?   @db.Timestamptz(3)
  /// The last time this person used the system (a signed-in request they made, recorded at most
  /// once a minute per session). Background refreshes do not count.
  lastActivityAt     DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  patients              Patient[]               @relation("PatientCreator")
  appointmentsCreated   Appointment[]           @relation("AppointmentCreator")
  appointmentsAssigned  Appointment[]           @relation("AppointmentClinician")
  appointmentsCancelled Appointment[]           @relation("AppointmentCanceller")
  encountersCreated     Encounter[]             @relation("EncounterCreator")
  encountersReceived    Encounter[]             @relation("EncounterReceiver")
  encountersPerformed   Encounter[]             @relation("EncounterClinician")
  encounterAmendments   EncounterAmendment[]
  notificationsSent     Notification[]
  notifications         NotificationRecipient[]
  auditEvents           AuditEvent[]
  sessions              StaffSession[]
  idempotencyRecords    IdempotencyRecord[]     @relation("IdempotencyPrincipal")
  createdByIdempotency  IdempotencyRecord?      @relation("IdempotencyStaffUser")
  admissionsAdmitted    Admission[]             @relation("AdmissionAdmitter")
  admissionsDischarged  Admission[]             @relation("AdmissionDischarger")
  roomAssignments       AdmissionRoomHistory[]

  @@index([role, status])
}

model StaffSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId String    @db.Uuid
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash   String    @unique @db.Char(64)
  csrfToken   String    @db.Char(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  /// When this session was last used, kept to the minute (see lastActivityAt on StaffUser).
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([staffUserId, revokedAt])
  @@index([expiresAt])
}

model Patient {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientNumber String             @unique @default(dbgenerated("('PT-'::text || upper((gen_random_uuid())::text))")) @db.VarChar(39)
  firstName     String             @db.VarChar(100)
  middleName    String?            @db.VarChar(100)
  lastName      String             @db.VarChar(100)
  dateOfBirth   DateTime?          @db.Date
  phone         String?            @db.VarChar(32)
  archivedAt    DateTime?          @db.Timestamptz(3)
  createdById   String             @db.Uuid
  createdBy     StaffUser          @relation("PatientCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  appointments  Appointment[]
  admissions    Admission[]
  encounters    Encounter[]
  idempotency   IdempotencyRecord?

  @@index([lastName, firstName])
  @@index([phone])
  @@index([createdAt])
  @@index([createdById])
}

// Appointments are no longer an application workflow (Phase 19A). The table and its history are
// kept read-only; no API route creates or changes appointments.
model Appointment {
  // SQL migration enforces clinician/patient [start,end) exclusion constraints
  // for SCHEDULED, CONFIRMED and CHECKED_IN. Preserve them in future migrations.
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference          String            @unique @default(dbgenerated("('AP-'::text || upper((gen_random_uuid())::text))")) @db.VarChar(39)
  patientId          String            @db.Uuid
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clinicianId        String?           @db.Uuid
  clinician          StaffUser?        @relation("AppointmentClinician", fields: [clinicianId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scheduledStart     DateTime          @db.Timestamptz(3)
  scheduledEnd       DateTime          @db.Timestamptz(3)
  type               AppointmentType
  status             AppointmentStatus @default(SCHEDULED)
  reason             String?           @db.VarChar(500)
  notes              String?
  cancelledAt        DateTime?         @db.Timestamptz(3)
  cancelledById      String?           @db.Uuid
  cancelledBy        StaffUser?        @relation("AppointmentCanceller", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancellationReason String?           @db.VarChar(500)
  createdById        String            @db.Uuid
  createdBy          StaffUser         @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  encounter          Encounter?
  notifications      Notification[]

  // Required by the composite FK that prevents cross-patient encounters.
  @@unique([id, patientId])
  @@index([patientId, scheduledStart])
  @@index([clinicianId, scheduledStart])
  @@index([status, scheduledStart])
  @@index([scheduledStart])
  @@index([createdById])
  @@index([cancelledById])
}

model Encounter {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference      String               @unique @default(dbgenerated("('MR-'::text || upper((gen_random_uuid())::text))")) @db.VarChar(39)
  patientId      String               @db.Uuid
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  appointmentId  String?              @db.Uuid
  appointment    Appointment?         @relation(fields: [appointmentId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Restrict)
  /// The admission this record belongs to. New records require a current admission (API and
  /// trigger); records made before admissions existed keep a null admission.
  admissionId    String?              @db.Uuid
  admission      Admission?           @relation(fields: [admissionId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Restrict)
  clinicianId    String?              @db.Uuid
  clinician      StaffUser?           @relation("EncounterClinician", fields: [clinicianId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receivedById   String?              @db.Uuid
  receivedBy     StaffUser?           @relation("EncounterReceiver", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdById    String               @db.Uuid
  createdBy      StaffUser            @relation("EncounterCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  occurredAt     DateTime             @default(now()) @db.Timestamptz(3)
  status         EncounterStatus      @default(DRAFT)
  roomLabel      String?              @db.VarChar(100)
  historySummary String?
  clinicalNotes  String?
  treatmentPlan  String?
  followUpAt     DateTime?            @db.Timestamptz(3)
  reviewedAt     DateTime?            @db.Timestamptz(3)
  voidedAt       DateTime?            @db.Timestamptz(3)
  voidReason     String?              @db.VarChar(500)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  complaints     EncounterComplaint[]
  diagnoses      Diagnosis[]
  medications    MedicationOrder[]
  amendments     EncounterAmendment[]
  idempotency    IdempotencyRecord?

  @@unique([appointmentId, patientId])
  @@index([patientId, occurredAt])
  @@index([admissionId, occurredAt])
  @@index([clinicianId, occurredAt])
  @@index([createdById])
  @@index([receivedById])
}

// Append-only through SQL triggers; no updatedAt or amendment update/delete API.
model EncounterAmendment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId String    @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authorId    String    @db.Uuid
  author      StaffUser @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reason      String    @db.VarChar(1000)
  content     String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([encounterId, createdAt])
  @@index([authorId, createdAt])
}

model EncounterComplaint {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId String    @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  description String    @db.VarChar(200)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([encounterId, description])
}

model Diagnosis {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId String    @db.Uuid
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  description String    @db.VarChar(500)
  code        String?   @db.VarChar(64)
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([encounterId])
}

// Prescribed while the clinical record is a draft and replaced as a set, like diagnoses; frozen by
// trigger once the record is finalized.
// A prescribed medicine on a clinical record. New orders name a catalog Medication; "medicine" keeps
// the catalog name as it was when prescribed (a trigger checks it), so history stays readable.
// Orders written before the catalog existed have no medicationId. Draft-only changes (trigger).
model MedicationOrder {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encounterId  String      @db.Uuid
  encounter    Encounter   @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  medicationId String?     @db.Uuid
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  medicine     String      @db.VarChar(200)
  strength     String?     @db.VarChar(100)
  dose         String?     @db.VarChar(100)
  route        String?     @db.VarChar(50)
  frequency    String?     @db.VarChar(100)
  duration     String?     @db.VarChar(100)
  notes        String?     @db.VarChar(2000)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@index([encounterId])
  @@index([medicationId])
}

// The controlled list Medical Officers prescribe from. Names are unique ignoring case (SQL
// expression index) and never change; entries are deactivated rather than deleted.
model Medication {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String            @db.VarChar(200)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  orders    MedicationOrder[]

  @@index([active, name])
}

// The current room is Admission.roomNumber; every assignment, including the first, is kept in
// AdmissionRoomHistory. Discharged admissions are permanent (trigger).
model Admission {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissionNumber String                 @unique @default(dbgenerated("next_admission_number()")) @db.VarChar(24)
  patientId       String                 @db.Uuid
  patient         Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roomNumber      String                 @db.VarChar(100)
  status          AdmissionStatus        @default(ADMITTED)
  admittedAt      DateTime               @db.Timestamptz(3)
  admittedById    String                 @db.Uuid
  admittedBy      StaffUser              @relation("AdmissionAdmitter", fields: [admittedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dischargedAt    DateTime?              @db.Timestamptz(3)
  dischargedById  String?                @db.Uuid
  dischargedBy    StaffUser?             @relation("AdmissionDischarger", fields: [dischargedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dischargeNotes  String?
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  rooms           AdmissionRoomHistory[]
  encounters      Encounter[]
  idempotency     IdempotencyRecord?

  // Required by the composite FK that keeps an encounter on its own patient's admission.
  @@unique([id, patientId])
  @@index([patientId, admittedAt])
  @@index([status, admittedAt])
  @@index([dischargedAt])
  @@index([admittedById])
  @@index([dischargedById])
}

// Append-only except closing the open assignment (endedAt), enforced by trigger.
model AdmissionRoomHistory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admissionId  String    @db.Uuid
  admission    Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roomNumber   String    @db.VarChar(100)
  note         String?   @db.VarChar(500)
  assignedAt   DateTime  @db.Timestamptz(3)
  assignedById String    @db.Uuid
  assignedBy   StaffUser @relation(fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endedAt      DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([admissionId, assignedAt])
  @@index([assignedById])
}

model Notification {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId   String                  @db.Uuid
  sender     StaffUser               @relation(fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type       NotificationType
  targetRole StaffRole?
  title      String                  @db.VarChar(200)
  message    String                  @db.VarChar(5000)
  createdAt  DateTime                @default(now()) @db.Timestamptz(3)
  recipients NotificationRecipient[]

  appointmentId String?            @db.Uuid
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  idempotency   IdempotencyRecord?

  @@index([senderId, createdAt])
  @@index([appointmentId])
}

model NotificationRecipient {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String       @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staffUserId    String       @db.Uuid
  staffUser      StaffUser    @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  readAt         DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([notificationId, staffUserId])
  @@index([staffUserId, readAt, createdAt])
  @@index([staffUserId, createdAt, id])
}

model AuditEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?         @db.Uuid
  actor      StaffUser?      @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  action     AuditAction
  entityType AuditEntityType
  entityId   String          @db.Uuid
  requestId  String?         @db.VarChar(128)
  ipAddress  String?         @db.Inet
  userAgent  String?         @db.VarChar(512)
  metadata   Json?           @db.JsonB
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

enum IdempotentOperation {
  PATIENT_CREATE
  ENCOUNTER_CREATE
  NOTIFICATION_BROADCAST
  STAFF_CREATE
  ADMISSION_CREATE
}

// Retry protection for selected create requests. Holds hashes and the created
// resource only; request bodies and responses are never stored.
model IdempotencyRecord {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  principalId    String              @db.Uuid
  principal      StaffUser           @relation("IdempotencyPrincipal", fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation      IdempotentOperation
  keyHash        String              @db.Char(64)
  requestHash    String              @db.Char(64)
  patientId      String?             @unique @db.Uuid
  patient        Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encounterId    String?             @unique @db.Uuid
  encounter      Encounter?          @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notificationId String?             @unique @db.Uuid
  notification   Notification?       @relation(fields: [notificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staffUserId    String?             @unique @db.Uuid
  staffUser      StaffUser?          @relation("IdempotencyStaffUser", fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  admissionId    String?             @unique @db.Uuid
  admission      Admission?          @relation(fields: [admissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime            @db.Timestamptz(3)

  @@unique([principalId, operation, keyHash])
  @@index([expiresAt])
}
