NODE_ENV=development
PORT=4000
# Replace with credentials for a dedicated local PostgreSQL database.
DATABASE_URL=postgresql://medicare:CHANGE_ME@localhost:5432/medicare
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Empty means no proxy trust. Set only actual reverse-proxy IPs/CIDRs, comma-separated.
TRUSTED_PROXY_CIDRS=

# Integration tests require NODE_ENV=test and a loopback control database whose
# name starts with medicare_test_. Its role needs CREATEDB permission.
# TEST_DATABASE_URL=postgresql://medicare_test:CHANGE_ME@127.0.0.1:5432/medicare_test_control

# Administrator bootstrap is opt-in. Supply these through a protected environment
# for npm run bootstrap:admin; never commit real values or reuse test credentials.
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_STAFF_NUMBER=
# BOOTSTRAP_ADMIN_PASSWORD=
